@page "{id:int}"
@model CtrlEat.RazorClient.Pages.StorageLocations.DeleteModel
@{ ViewData["Title"] = "Delete Storage Location"; }
<h1>Delete Storage Location</h1>
@if (Model.ErrorMessage is not null) { <div class="alert" role="alert">@Model.ErrorMessage</div> }
@if (Model.Location is not null) { <p>Are you sure you want to delete <strong>@Model.Location.Name</strong> (@Model.Location.Type)?</p><form method="post"><button class="danger" type="submit">Delete</button> <a class="button secondary" asp-page="Details" asp-route-id="@Model.Id">Cancel</a></form> }