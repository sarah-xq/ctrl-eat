@page
@model Recipe.Client.Pages.IndexModel
<!doctype html><html><head><meta charset="utf-8"/><title>Recipe Management</title></head>
<body><main style="font:16px system-ui;max-width:850px;margin:40px auto">
<h1>Recipes</h1><p><a href="/logout">Sign out</a></p>
@if (Model.Error is not null) { <p role="alert">@Model.Error</p> }
<h2>Add or update recipe</h2><form method="post" asp-page-handler="Save">
<label>ID (0 to create) <input name="Id" type="number" min="0" value="0" /></label>
<label>Name <input name="Name" required /></label>
<label>Author <input name="Author" /></label>
<label>Description <input name="Description" /></label>
<label>Total minutes <input name="TotalTimeMinutes" type="number" min="0" required /></label>
<label>Cook minutes <input name="CookTimeMinutes" type="number" min="0" required /></label>
<label>Ingredient ID <input name="IngredientId" type="number" min="0" /></label>
<label>Quantity <input name="Quantity" type="number" step="0.01" min="0.01" value="1" /></label>
<label>Unit <input name="Unit" value="serving" /></label>
<button>Save</button></form><p>Note: this minimal client edits one ingredient at a time; the API supports multiple ingredients.</p>
<h2>Saved recipes</h2><table cellpadding="8"><thead><tr><th>ID</th><th>Name</th><th>Author</th><th>Calories</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Author</td><td>@item.TotalCalories</td><td><form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"><button>Delete</button></form></td></tr> }
</tbody></table></main></body></html>
